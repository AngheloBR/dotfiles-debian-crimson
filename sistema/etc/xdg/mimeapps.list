# mimeapps.list — apps por defecto del Rice "Debian Crimson"
# Va en /etc/xdg/mimeapps.list (nivel SISTEMA): xdg-open, thunar, rofi...
# lo usan como respaldo para todo lo que el usuario no haya cambiado.
# NO se gestiona ~/.config/mimeapps.list con stow: Firefox y xdg-mime lo
# reescriben (y rompen el symlink) cada vez que se ponen por defecto.
# Los .desktop propios (nvim, feh) viven en el paquete stow "xdg".
#
# Comprobar:   xdg-mime query default image/png
# Tipo de un archivo:  xdg-mime query filetype foto.jpg

[Default Applications]
# web
x-scheme-handler/http=firefox-esr.desktop
x-scheme-handler/https=firefox-esr.desktop
text/html=firefox-esr.desktop
application/xhtml+xml=firefox-esr.desktop
# PDF: zathura (teclas de vim; config en el paquete stow "zathura")
application/pdf=org.pwmt.zathura.desktop
application/epub+zip=org.pwmt.zathura.desktop
# video y audio: mpv
video/mp4=mpv.desktop
video/x-matroska=mpv.desktop
video/webm=mpv.desktop
video/x-msvideo=mpv.desktop
video/quicktime=mpv.desktop
audio/mpeg=mpv.desktop
audio/flac=mpv.desktop
audio/ogg=mpv.desktop
audio/x-wav=mpv.desktop
audio/mp4=mpv.desktop
# imagenes
image/png=feh.desktop
image/jpeg=feh.desktop
image/gif=feh.desktop
image/webp=feh.desktop
image/bmp=feh.desktop
image/tiff=feh.desktop
image/svg+xml=feh.desktop
# texto y codigo
text/plain=nvim.desktop
text/markdown=nvim.desktop
text/x-shellscript=nvim.desktop
application/x-shellscript=nvim.desktop
text/x-python=nvim.desktop
text/x-lua=nvim.desktop
text/x-c=nvim.desktop
text/x-c++=nvim.desktop
application/json=nvim.desktop
application/x-yaml=nvim.desktop
text/yaml=nvim.desktop
text/csv=nvim.desktop
text/x-log=nvim.desktop
# carpetas y comprimidos
inode/directory=thunar.desktop
application/zip=org.gnome.FileRoller.desktop
application/x-tar=org.gnome.FileRoller.desktop
application/gzip=org.gnome.FileRoller.desktop
application/x-xz=org.gnome.FileRoller.desktop
application/x-7z-compressed=org.gnome.FileRoller.desktop
application/vnd.rar=org.gnome.FileRoller.desktop
# claude (app de escritorio y claude code)
x-scheme-handler/claude=com.anthropic.Claude.desktop
x-scheme-handler/claude-cli=claude-code-url-handler.desktop

[Added Associations]
text/plain=nvim.desktop;
application/pdf=org.pwmt.zathura.desktop;
