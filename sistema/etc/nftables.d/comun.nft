# Reglas COMUNES a los dos perfiles del firewall — Rice "Debian Crimson"
# (las incluyen perfil-privada.nft y perfil-publica.nft)
#
# OJO: se hace "flush table", NO "flush ruleset": libvirt tiene su propia
# tabla (NAT de las VMs) y un flush global la borraria -> VMs sin internet.

table inet filter
flush table inet filter

table inet filter {
    # la cadena del perfil se declara aqui VACIA para que el "jump" de abajo
    # la encuentre (nft lee en orden); el archivo del perfil le añade reglas
    chain perfil {
    }

    chain input {
        type filter hook input priority 0; policy drop;

        iif "lo" accept                                  # localhost
        ct state established,related accept             # respuestas a lo que pedimos
        ct state invalid drop
        ip6 nexthdr icmpv6 accept                        # ipv6 necesita esto (vecinos, router)
        udp dport 546 accept                             # DHCPv6
        # puentes de virtualizacion: la laptop les da DHCP/DNS. Por prefijo,
        # para cubrir KVM (virbr*), LXD/Incus (lxdbr*, incusbr*), LXC (lxcbr*)
        # y Docker (docker*) sin tocar esto cada vez que se añade una
        iifname "virbr*" accept
        iifname "lxdbr*" accept
        iifname "incusbr*" accept
        iifname "lxcbr*" accept
        iifname "docker*" accept

        jump perfil                                      # lo que depende del perfil
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
        # VMs y contenedores hacia internet (el NAT lo pone cada herramienta:
        # libvirt, LXD...) y las respuestas de vuelta
        iifname "virbr*" accept
        iifname "lxdbr*" accept
        iifname "incusbr*" accept
        iifname "lxcbr*" accept
        iifname "docker*" accept
        oifname "virbr*" ct state established,related accept
        oifname "lxdbr*" ct state established,related accept
        oifname "incusbr*" ct state established,related accept
        oifname "lxcbr*" ct state established,related accept
        oifname "docker*" ct state established,related accept
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}
