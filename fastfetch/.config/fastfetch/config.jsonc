// fastfetch — Rice "Debian Crimson"
// Logo propio (logo.txt): $1 = carmesi, $2 = dorado. Sin IP, bateria ni
// modelo de equipo (informacion que no hace falta ver cada vez).
// Probar cambios: fastfetch   |  modulos disponibles: fastfetch --list-modules
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "38;2;215;10;83", "2": "38;2;232;176;75" },
    "padding": { "top": 1, "left": 1, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;232;176;75", "title": "38;2;215;10;83" },
    "key": { "width": 16 }
  },
  "modules": [
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}", "color": { "user": "38;2;215;10;83", "at": "38;2;69;71;78", "host": "38;2;232;176;75" } },
    { "type": "separator", "string": "─", "length": 40, "outputColor": "38;2;43;43;46" },
    { "type": "os",           "key": "󰣚  sistema",  "format": "{pretty-name} {arch}" },
    { "type": "kernel",       "key": "󰌽  kernel",   "format": "{release}" },
    { "type": "uptime",       "key": "󰔟  encendido", "format": "{days}d {hours}h {minutes}m" },
    { "type": "packages",     "key": "󰏗  paquetes" },
    { "type": "shell",        "key": "󰆍  shell",    "format": "{pretty-name} {version}" },
    { "type": "wm",           "key": "󰖯  wm",       "format": "{pretty-name}" },
    { "type": "terminal",     "key": "󰒉  terminal", "format": "{pretty-name}" },
    { "type": "terminalfont", "key": "󰛖  fuente" },
    { "type": "custom",       "key": " ",          "format": "" },
    { "type": "cpu",          "key": "󰻠  cpu",      "format": "{name} ({cores-physical}c/{cores-logical}t)" },
    { "type": "gpu",          "key": "󰢮  gpu",      "format": "{name}", "hideType": "discrete" },
    { "type": "memory",       "key": "󰍛  memoria" },
    { "type": "disk",         "key": "󰋊  disco",    "folders": "/" },
    { "type": "custom",       "key": " ",          "format": "" },
    { "type": "colors",       "symbol": "circle", "paddingLeft": 2 }
  ]
}
