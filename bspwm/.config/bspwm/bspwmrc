#!/bin/bash
# bspwmrc — Rice "Debian Crimson"
#
# Es bash (no sh) para poder escribir los iconos Nerd Font como
# escapes \U000fXXXX: asi el archivo es ASCII puro y no se pierden
# los glifos al copiar/pegar (leccion de la guia, seccion 7).

# lightdm arranca la sesion con un PATH pelado (sin ~/.local/bin).
# Sin esta linea, "ajustar-monitores.sh" no se encuentra, y por lo
# tanto polybar nunca arranca. Todo lo que nace de bspwm (sxhkd,
# rofi, kitty...) hereda este PATH.
export PATH="$HOME/.local/bin:$PATH"

setxkbmap latam &

# ── iconos de escritorios (Material Design, Nerd Font v3) ──
D1=$(printf '\U000f0489')   # terminal
D2=$(printf '\U000f059f')   # web
D3=$(printf '\U000f0169')   # codigo
D4=$(printf '\U000f024b')   # archivos
D5=$(printf '\U000f075a')   # musica
D6=$(printf '\U000f0b79')   # chat
D7=$(printf '\U000f0493')   # ajustes
D8=$(printf '\U000f01ee')   # correo
D9=$(printf '\U000f01da')   # descargas
D10=$(printf '\U000f00ba')  # lectura

# escritorios solo en la laptop (10 iconos)
bspc monitor eDP -d "$D1" "$D2" "$D3" "$D4" "$D5" "$D6" "$D7" "$D8" "$D9" "$D10"

# ── aspecto ──
bspc config border_width          2
bspc config window_gap            12
bspc config split_ratio           0.52
bspc config borderless_monocle    true
bspc config gapless_monocle       true
bspc config focused_border_color  "#D70A53"
bspc config normal_border_color   "#2b2b2e"

# ── reglas de ventanas (solo apps que existen en el sistema) ──
bspc rule -a flameshot  state=floating
bspc rule -a thunar     state=floating rectangle=1000x650+0+0 center=true
bspc rule -a calendario state=floating rectangle=700x560+0+0 center=true

# ── demonios ──
# Los "pgrep ||" evitan procesos duplicados si se hace "bspc wm -r"
# (bspwmrc se vuelve a ejecutar entero al reiniciar bspwm).
pgrep -x sxhkd >/dev/null || sxhkd &
pgrep -x picom >/dev/null || picom &
pgrep -x dunst >/dev/null || dunst &

# candado automatico: antes de suspender (tapa cerrada, systemctl suspend)
# y tras 10 min sin actividad (timeout del salvapantallas de X, "xset q").
# --transfer-sleep-lock retrasa la suspension hasta que i3lock ya esta puesto,
# asi al abrir la tapa nunca se ve el escritorio.
pgrep -x xss-lock >/dev/null || xss-lock --transfer-sleep-lock -- bloquear.sh &

# aviso de bateria baja (20% y 10%)
pgrep -f aviso-bateria.sh >/dev/null || aviso-bateria.sh &

# wallpaper inmediato (ajustar-monitores lo re-aplica tras acomodar el HDMI)
feh --bg-scale ~/.dotfiles/wallpapers/fondo.png &

# monitores + polybar (HDMI solo wallpaper; la barra vive en eDP)
ajustar-monitores.sh &
