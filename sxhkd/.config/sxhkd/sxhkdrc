#
# atajos independientes del wm
#

# terminal
super + Return
        kitty

# lanzador de aplicaciones
super + d
        rofi -show drun

# gestor de archivos
super + e
        thunar

# recargar la configuracion de sxhkd
super + Escape
        pkill -USR1 -x sxhkd

# chuleta con todos los atajos (esta lista sale de este archivo)
super + F1
        ~/.local/bin/atajos.sh

# navegador
super + b
        firefox

# editor de codigo (LazyVim dentro de kitty)
super + n
	kitty -e ~/.local/bin/nvim

# notificaciones: volver a mostrar la ultima que se cerro
super + shift + n
	dunstctl history-pop

# notificaciones: cerrar todas
super + ctrl + n
	dunstctl close-all

# portapapeles: historial de lo copiado
super + v
	~/.local/bin/portapapeles.sh menu

#
# atajos de bspwm
#

# salir/reiniciar bspwm
super + alt + {q,r}
        bspc {quit,wm -r}

# cerrar y matar ventana
super + {_,shift + }w
        bspc node -{c,k}

# alternar entre layout tiled y monocle
super + m
        bspc desktop -l next

# enviar la ventana marcada mas reciente a la preseleccion mas reciente
super + y
        bspc node newest.marked.local -n newest.!automatic.local

# intercambiar la ventana actual con la mas grande
super + g
        bspc node -s biggest.window

#
# estados/flags
#

# estado de la ventana: tiling / pseudo-tiling / flotante / pantalla completa
super + {t,shift + t,s,f}
        bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# flags del nodo: marcada / bloqueada / pegajosa / privada
super + ctrl + {m,x,y,z}
        bspc node -g {marked,locked,sticky,private}

#
# enfoque/intercambio
#

# enfocar la ventana en la direccion dada (west/surd/north/este)
# con shift: intercambiar ventana en esa direccion
super + {_,shift + }{h,j,k,l}
        bspc node -{f,s} {west,south,north,east}

# enfocar el nodo segun el salto dado (padre/hermano/primero/segundo)
super + {p,b,comma,period}
        bspc node -f @{parent,brother,first,second}

# enfocar la ventana siguiente/anterior del escritorio actual
super + {_,shift + }c
        bspc node -f {next,prev}.local.!hidden.window

# enfocar el escritorio siguiente/anterior del monitor actual
super + bracket{left,right}
        bspc desktop -f {prev,next}.local

# enfocar el ultimo nodo/escritorio usado
super + {grave,Tab}
        bspc {node,desktop} -f last

# enfocar el nodo mas antiguo o mas nuevo del historial
super + {o,i}
        bspc wm -h off; \
        bspc node {older,newer} -f; \
        bspc wm -h on

# enfocar o enviar ventana al escritorio dado (con shift: enviar)
super + {_,shift + }{1-9,0}
        bspc {desktop -f,node -d} '^{1-9,10}'

#
# preseleccion
#

# preseleccionar la direccion donde abrira la proxima ventana
super + ctrl + {h,j,k,l}
        bspc node -p {west,south,north,east}

# preseleccionar la proporcion (10% ... 90%)
super + ctrl + {1-9}
        bspc node -o 0.{1-9}

# cancelar la preseleccion del nodo enfocado
super + ctrl + space
        bspc node -p cancel

# cancelar la preseleccion de todo el escritorio
super + ctrl + shift + space
        bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

#
# mover/redimensionar
#

# expandir ventana hacia afuera
super + alt + {h,j,k,l}
        bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# contraer ventana hacia adentro
super + alt + shift + {h,j,k,l}
        bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# mover ventana flotante con flechas
super + {Left,Down,Up,Right}
        bspc node -v {-20 0,0 20,0 -20,20 0}

# captura de pantalla con flameshot
Print
        flameshot gui

# captura de pantalla completa (sin seleccionar)
shift + Print
        flameshot full -c

# bloquear pantalla: tecla del candado (F10) o su version XF86 si Fn-lock
# la emite asi. Las llaves {a,b} en sxhkd = "cualquiera de las dos".
{F10,XF86ScreenSaver}
	~/.local/bin/bloquear.sh

#
# teclas multimedia (hardware real)
# Toda la logica (pactl/brightnessctl + notificacion) vive en
# ~/.local/bin/multimedia.sh: aqui solo se mapea la tecla.
#

XF86AudioRaiseVolume
	~/.local/bin/multimedia.sh vol +

XF86AudioLowerVolume
	~/.local/bin/multimedia.sh vol -

XF86AudioMute
	~/.local/bin/multimedia.sh vol mute

XF86MonBrightness{Up,Down}
	~/.local/bin/multimedia.sh brillo {+,-}

#
# teclas fisicas del Lenovo (fila Fn)
#

# microfono mute/unmute (F4)
{F4,XF86AudioMicMute}
	~/.local/bin/multimedia.sh mic

# modo avion (F8): toggle del Wi-Fi
{F8,XF86AirplaneMode}
	~/.local/bin/red-wifi.sh toggle

# ajustes del sistema (F9)
{F9,XF86Tools}
	~/.local/bin/ajustes.sh
