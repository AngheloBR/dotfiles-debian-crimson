// ═══════════════════════════════════════════════
//  rofi — Rice "Debian Crimson"
//  Tema OSCURO: fondo negro, tarjetas oscuras,
//  seleccion carmesi. Estados explicitos (rofi 1.7)
// ═══════════════════════════════════════════════

configuration {
    modi: "drun,run,window";
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    icon-theme: "Papirus-Dark";

    // iconos literales (rasi no interpreta \u): nf-md-apps U+F003B,
    // nf-md-console_line U+F0B98, nf-md-window_restore U+F05AF
    display-drun:   "󰀻  Apps";
    display-run:    "󰮘  Ejecutar";
    display-window: "󰖯  Ventanas";

    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";

    drun-display-format: "{name}";
}

* {
    background-color: transparent;
    text-color: #d6d6d6;
}

// "-- ventana (negra, borde carmesi) --"
window {
    background-color: #0f0f12;
    border: 2px;
    border-color: #D70A53;
    border-radius: 14px;
    width: 660px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: #0f0f12;
    border-radius: 14px;
    children: [ inputbar, listview ];
    spacing: 12px;
    padding: 16px;
}

// "-- barra de busqueda --"
inputbar {
    background-color: #191920;
    border-radius: 10px;
    padding: 10px 12px;
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: #E8B04B;
    padding: 2px 4px 2px 2px;
}

entry {
    placeholder: "Buscar programa...";
    placeholder-color: #45474e;
    text-color: #d6d6d6;
    cursor: text;
    background-color: transparent;
}

// "-- rejilla de apps --"
listview {
    columns: 4;
    lines: 3;
    cycle: true;
    scrollbar: false;
    spacing: 8px;
    fixed-height: true;
    fixed-columns: true;
    layout: vertical;
    background-color: transparent;
}

// tarjetas oscuras (estado base explicito)
element {
    orientation: vertical;
    padding: 10px 6px;
    spacing: 6px;
    border-radius: 10px;
    background-color: #191920;
    text-color: #d6d6d6;
}

// OJO: el tema base de rofi define "element normal.normal" y
// "element alternate.normal" (mas especificos que "element" a secas),
// y ganan: sin estas lineas las tarjetas salen CREMA del tema default.
element normal.normal,
element alternate.normal {
    background-color: #191920;
    text-color: #d6d6d6;
}

// seleccion carmesi (estado explicito con espacio)
element selected.normal,
element selected.active,
element selected.urgent {
    background-color: #D70A53;
    text-color: #0f0f12;
}

// urgente/activo (ventanas que piden atencion en el modo "window")
element normal.urgent,
element alternate.urgent {
    background-color: #191920;
    text-color: #D70A53;
}
element normal.active,
element alternate.active {
    background-color: #191920;
    text-color: #E8B04B;
}

element-icon {
    size: 40px;
    horizontal-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

// "-- errores --"
error-message {
    background-color: #0f0f12;
    border: 2px;
    border-color: #D70A53;
    border-radius: 10px;
    padding: 12px;
}
