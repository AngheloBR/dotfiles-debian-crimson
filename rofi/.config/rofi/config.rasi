// ═══════════════════════════════════════════════
//  rofi — Rice "Debian Crimson"
//  Tema OSCURO con acento carmesi / dorado
// ═══════════════════════════════════════════════

configuration {
    modi: "drun,run,window";
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    icon-theme: "Papirus-Dark";

    display-drun:   "  Apps";
    display-run:    "  Ejecutar";
    display-window: "  Ventanas";

    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";

    drun-display-format: "{name}";
}

* {
    bg:        #0f0f12;   /* negro profundo */
    bg-alt:    #191920;   /* casi negro, un punto mas claro */
    bg-sel:    #D70A53;   /* carmesi para lo seleccionado */
    fg:        #d6d6d6;   /* texto normal */
    fg-weak:   #45474e;   /* gris para placeholder */
    crimson:   #D70A53;
    gold:      #E8B04B;

    background-color: transparent;
    text-color: @fg;
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @crimson;
    border-radius: 14px;
    width: 640px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: @bg;
    border-radius: 14px;
    children: [ inputbar, listview ];
    spacing: 12px;
    padding: 16px;
}

// "-- barra de busqueda --"
inputbar {
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 10px 12px;
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @gold;
    padding: 2px 4px 2px 2px;
}

entry {
    placeholder: "Buscar programa...";
    placeholder-color: @fg-weak;
    text-color: @fg;
    cursor: text;
}

// "-- rejilla de programas --"
listview {
    columns: 4;
    lines: 3;
    cycle: true;
    scrollbar: false;
    spacing: 8px;
    fixed-height: true;
    fixed-columns: true;
    layout: vertical;
    background-color: transparent;
}

element {
    orientation: vertical;
    padding: 10px 6px;
    spacing: 6px;
    border-radius: 10px;
    background-color: @bg-alt;   /* tarjeta oscura */
    text-color: @fg;
}

element-icon {
    size: 40px;
    horizontal-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element selected.normal {
    background-color: @bg-sel;    /* tarjeta carmesi */
    text-color: @bg;
}

element-text selected.normal,
element-icon selected.normal {
    background-color: transparent;
    text-color: @bg;
}

// "-- errores --"
error-message {
    background-color: @bg;
    border: 2px;
    border-color: @crimson;
    border-radius: 10px;
    padding: 12px;
}
