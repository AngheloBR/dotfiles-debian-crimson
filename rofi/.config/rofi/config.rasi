configuration {
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
}

* {
    bg: #0f0f12;
    bg-alt: #1a1a1e;
    fg: #b3b3b8;
    crimson: #D70A53;
    gold: #E8B04B;

    background-color: transparent;
    text-color: @fg;
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @crimson;
    border-radius: 8px;
    width: 40%;
}

inputbar {
    background-color: @bg-alt;
    text-color: @fg;
    padding: 8px;
}

prompt { text-color: @gold; }

element selected {
    background-color: @crimson;
    text-color: #0f0f12;
}
